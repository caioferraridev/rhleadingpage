# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your-access-token
# Opcional: validar assinatura HMAC das notificações do webhook
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# Emails (Resend) — sistema de comunicação com inscritos
# 1) Crie a API Key em https://resend.com/api-keys
# 2) Adicione e verifique um domínio (ou use o endereço onbrushing.com do plano gratuito)
# 3) EMAIL_FROM pode ser "Academia RH <contato@seudominio.com.br>"
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Academia RH <seu-email-verificado@seudominio.com.br>
# Destinatário dos avisos administrativos de novas inscrições
ADMIN_EMAIL=adm@example.com
# Segredo usado pela rota /api/cron/emails (Bearer). No Vercel, o Cron envia
# automaticamente `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=generate-a-long-random-string

# Admin
ADMIN_PASSWORD=your-admin-password

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
